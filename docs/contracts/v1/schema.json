{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.evocortex.ai/saturn-node/compute/v1/schema.json",
  "title": "Saturn-Node Workload Compute Contract v1",
  "contractVersion": "1",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "modelCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelId",
        "maximumContextTokens",
        "maximumOutputTokens"
      ],
      "properties": {
        "modelId": {
          "$ref": "#/$defs/identifier"
        },
        "maximumContextTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "maximumOutputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        }
      }
    },
    "workloadClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "credentialId",
        "issuer",
        "audience",
        "workloadId",
        "deploymentId",
        "nodeId",
        "modelId",
        "maximumContextTokens",
        "maximumOutputTokens",
        "maximumConcurrentRequests",
        "requestBudget",
        "tokenBudget",
        "issuedAt",
        "notBefore",
        "expiresAt",
        "epoch"
      ],
      "properties": {
        "contractVersion": {
          "const": "1"
        },
        "credentialId": {
          "$ref": "#/$defs/identifier"
        },
        "issuer": {
          "const": "saturn-control"
        },
        "audience": {
          "type": "string",
          "minLength": 13,
          "maxLength": 160,
          "pattern": "^saturn-node:[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "workloadId": {
          "$ref": "#/$defs/identifier"
        },
        "deploymentId": {
          "$ref": "#/$defs/identifier"
        },
        "nodeId": {
          "$ref": "#/$defs/identifier"
        },
        "modelId": {
          "$ref": "#/$defs/identifier"
        },
        "maximumContextTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "maximumOutputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "maximumConcurrentRequests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "requestBudget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "tokenBudget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "issuedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "notBefore": {
          "$ref": "#/$defs/timestamp"
        },
        "expiresAt": {
          "$ref": "#/$defs/timestamp"
        },
        "epoch": {
          "type": "integer",
          "minimum": 0
        },
        "policyReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "approvalReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "capabilitiesResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "nodeId",
        "serviceVersion",
        "state",
        "models",
        "maximumConcurrentRequests",
        "acceptedCredentialEpoch"
      ],
      "properties": {
        "contractVersion": {
          "const": "1"
        },
        "nodeId": {
          "$ref": "#/$defs/identifier"
        },
        "serviceVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "state": {
          "type": "string",
          "enum": [
            "available",
            "degraded",
            "saturated",
            "unavailable"
          ]
        },
        "models": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/modelCapability"
          }
        },
        "maximumConcurrentRequests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "acceptedCredentialEpoch": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "inferenceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestId",
        "requestNonce",
        "workloadId",
        "deploymentId",
        "modelId",
        "inputText",
        "maximumContextTokens",
        "maximumOutputTokens",
        "deadlineAt"
      ],
      "properties": {
        "contractVersion": {
          "const": "1"
        },
        "requestId": {
          "$ref": "#/$defs/uuid"
        },
        "requestNonce": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "workloadId": {
          "$ref": "#/$defs/identifier"
        },
        "deploymentId": {
          "$ref": "#/$defs/identifier"
        },
        "modelId": {
          "$ref": "#/$defs/identifier"
        },
        "inputText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000
        },
        "maximumContextTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "maximumOutputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "deadlineAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "streamEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestId",
        "sequence",
        "type"
      ],
      "properties": {
        "contractVersion": {
          "const": "1"
        },
        "requestId": {
          "$ref": "#/$defs/uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "enum": [
            "started",
            "delta",
            "usage",
            "completed",
            "cancelled"
          ]
        },
        "nodeId": {
          "$ref": "#/$defs/identifier"
        },
        "modelId": {
          "$ref": "#/$defs/identifier"
        },
        "delta": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "finishReason": {
          "type": "string",
          "enum": [
            "stop",
            "length",
            "cancelled"
          ]
        }
      }
    },
    "usageEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestId",
        "workloadId",
        "deploymentId",
        "nodeId",
        "modelId",
        "startedAt",
        "completedAt",
        "inputTokens",
        "outputTokens",
        "outcome"
      ],
      "properties": {
        "contractVersion": {
          "const": "1"
        },
        "requestId": {
          "$ref": "#/$defs/uuid"
        },
        "workloadId": {
          "$ref": "#/$defs/identifier"
        },
        "deploymentId": {
          "$ref": "#/$defs/identifier"
        },
        "nodeId": {
          "$ref": "#/$defs/identifier"
        },
        "modelId": {
          "$ref": "#/$defs/identifier"
        },
        "startedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "completedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outcome": {
          "type": "string",
          "enum": [
            "completed",
            "cancelled",
            "failed"
          ]
        },
        "policyReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "approvalReference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "cancellationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "requestId",
        "state"
      ],
      "properties": {
        "contractVersion": {
          "const": "1"
        },
        "requestId": {
          "$ref": "#/$defs/uuid"
        },
        "state": {
          "type": "string",
          "enum": [
            "cancellation_requested",
            "cancelled"
          ]
        }
      }
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title",
        "status",
        "code",
        "requestId"
      ],
      "properties": {
        "type": {
          "type": "string",
          "format": "uri-reference"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "code": {
          "type": "string",
          "enum": [
            "contract_version_unsupported",
            "malformed_request",
            "unauthenticated",
            "unauthorized",
            "wrong_audience",
            "wrong_workload",
            "wrong_deployment",
            "wrong_node",
            "model_not_allowed",
            "credential_not_yet_valid",
            "credential_expired",
            "credential_revoked",
            "credential_replayed",
            "stale_credential_epoch",
            "request_limit_exceeded",
            "token_budget_exceeded",
            "node_saturated",
            "request_timeout",
            "cancelled",
            "internal_failure"
          ]
        },
        "requestId": {
          "$ref": "#/$defs/uuid"
        },
        "detail": {
          "type": "string",
          "maxLength": 2048
        },
        "retryAfterSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        }
      }
    }
  }
}
